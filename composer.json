{
    "name": "zjkiza/response-processor",
    "description": "Symfony bundle for automatically enrich DTO response objects with relational data using PHP 8 attributes",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Zoran Jankovic",
            "email": "zjkiza@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/http-kernel": "^5.4|^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^5.4|^6.0|^7.0|^8.0",
        "symfony/config": "^5.4|^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.52",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "rector/rector": "^2.0",
        "vimeo/psalm": "^6.13",
        "phpunit/phpunit": "^12.4",
        "psalm/plugin-phpunit": "^0.19",
        "icanhazstring/composer-unused": "^0.9.5",
        "psalm/plugin-symfony": "^5.2",
        "symfony/framework-bundle": "^8.0",
        "symfony/yaml": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/phpunit-bridge": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "ZJKiza\\ResponseProcessor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZJKiza\\ResponseProcessor\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "phpunit": "XDEBUG_MODE=coverage vendor/bin/phpunit --testdox --coverage-html ./build/phpunit",
        "phpstan": "vendor/bin/phpstan analyse -v",
        "psalm": "vendor/bin/psalm --threads=8 --no-diff --no-cache",
        "rector": "vendor/bin/rector",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix --diff --verbose --show-progress=dots --allow-risky=yes"
    }
}
